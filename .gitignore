# ─── Audio files (too large for git) ────────────────────────────────────────
*.wav
*.mp3
*.ogg
*.flac

# ─── Keep empty directory markers ────────────────────────────────────────────
!.gitkeep

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ─── ML models (large) — keep .tflite and .cc, ignore .h5 ──────────────────
# ml/models/*.h5     ← keep these (small enough, useful for team)
# ml/models/*.tflite ← keep these (43 KB, needed by S3)

# ─── Numpy dataset arrays (regenerated by augment.py) ────────────────────────
ml/data/*.npy

# ─── naad_kws/ dataset tree (audio files — use shared Drive) ─────────────────
naad_kws/raw/
naad_kws/raw_wav/
naad_kws/augmented/
naad_kws/final/
naad_kws/real/
naad_kws/noise/
naad_kws/voice_tests/

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
